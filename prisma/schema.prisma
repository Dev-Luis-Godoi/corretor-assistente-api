generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  AGENT
}

enum AccountStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELED
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  CONTACT
  UNKNOWN
}

enum MessageDeliveryStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum LeadActivityType {
  CREATED
  NOTE
  CALL
  EMAIL
  WHATSAPP
  STAGE_CHANGED
}

enum TaskStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TemplateChannel {
  WHATSAPP
  EMAIL
}

enum AutomationTrigger {
  LEAD_CREATED
  STAGE_CHANGED
}

enum AutomationAction {
  CREATE_TASK
  ASSIGN_LEAD
}

enum ConsentStatus {
  UNKNOWN
  GRANTED
  REVOKED
}

enum PropertyType {
  APARTMENT
  HOUSE
  LAND
  COMMERCIAL
  RURAL
  OTHER
}

enum PropertyPurpose {
  SALE
  RENT
}

enum PropertyStatus {
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  INACTIVE
}

model Organization {
  id                String        @id @default(uuid())
  name              String
  dataRetentionDays Int           @default(730)
  status            AccountStatus @default(TRIAL)
  trialEndsAt       DateTime?
  suspendedAt       DateTime?

  users                  User[]
  contacts               Contact[]
  conversations          Conversation[]
  messages               Message[]
  leads                  Lead[]
  stages                 PipelineStage[]
  whatsappAccounts       WhatsappAccount[]
  leadActivities         LeadActivity[]
  leadStageHistory       LeadStageHistory[]
  tasks                  Task[]
  messageTemplates       MessageTemplate[]
  automationRules        AutomationRule[]
  auditLogs              AuditLog[]
  notificationDismissals NotificationDismissal[]
  platformAuditLogs      PlatformAuditLog[]
  properties             Property[]
  owners                 Owner[]
  clients                Client[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  passwordHash   String
  role           UserRole  @default(AGENT)
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedLeads          Lead[]                  @relation("LeadAssignedUser")
  assignedTasks          Task[]                  @relation("TaskAssignedUser")
  createdActivities      LeadActivity[]          @relation("ActivityCreatedBy")
  passwordResetTokens    PasswordResetToken[]
  auditLogs              AuditLog[]
  notificationDismissals NotificationDismissal[]
  platformAuditLogs      PlatformAuditLog[]      @relation("PlatformAuditTargetUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model PlatformAdmin {
  id             String             @id @default(uuid())
  name           String
  email          String             @unique
  passwordHash   String
  active         Boolean            @default(true)
  sessionVersion Int                @default(0)
  lastLoginAt    DateTime?
  auditLogs      PlatformAuditLog[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model PlatformAuditLog {
  id                   String        @id @default(uuid())
  action               String
  metadata             Json?
  adminId              String
  admin                PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Restrict)
  targetOrganizationId String?
  targetOrganization   Organization? @relation(fields: [targetOrganizationId], references: [id], onDelete: SetNull)
  targetUserId         String?
  targetUser           User?         @relation("PlatformAuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime      @default(now())

  @@index([adminId, createdAt])
  @@index([targetOrganizationId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model WhatsappAccount {
  id           String  @id @default(uuid())
  name         String
  phoneNumber  String?
  externalId   String?
  instanceName String?
  isConnected  Boolean @default(false)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, phoneNumber])
  @@index([organizationId])
}

model Contact {
  id            String        @id @default(uuid())
  name          String?
  phone         String
  email         String?
  avatarUrl     String?
  origin        String?
  consentStatus ConsentStatus @default(UNKNOWN)
  consentAt     DateTime?
  consentSource String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  conversations Conversation[]
  leads         Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, phone])
  @@index([organizationId])
}

model Conversation {
  id            String             @id @default(uuid())
  status        ConversationStatus @default(OPEN)
  unreadCount   Int                @default(0)
  lastMessageAt DateTime?
  externalId    String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  whatsappAccountId String
  whatsappAccount   WhatsappAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)

  messages Message[]

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([whatsappAccountId, contactId])
  @@index([organizationId])
  @@index([contactId])
  @@index([lastMessageAt])
  @@index([leadId])
}

model Message {
  id             String                @id @default(uuid())
  externalId     String?
  direction      MessageDirection
  type           MessageType           @default(TEXT)
  content        String?
  mediaUrl       String?
  sentAt         DateTime
  readAt         DateTime?
  metadata       Json?
  deliveryStatus MessageDeliveryStatus @default(SENT)
  deliveredAt    DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, externalId])
  @@index([organizationId])
  @@index([conversationId, sentAt])
}

model PipelineStage {
  id       String  @id @default(uuid())
  name     String
  position Int
  color    String?
  isWon    Boolean @default(false)
  isLost   Boolean @default(false)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leads          Lead[]
  historyEntries LeadStageHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, position])
  @@index([organizationId])
}

model Lead {
  id                String    @id @default(uuid())
  title             String
  source            String?
  notes             String?
  estimatedValue    Decimal?  @db.Decimal(12, 2)
  closedAt          DateTime?
  lostReason        String?
  interest          String?
  tags              String[]  @default([])
  nextFollowUpAt    DateTime?
  expectedCloseAt   DateTime?
  lastInteractionAt DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  stageId String
  stage   PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  assignedUserId String?
  assignedUser   User?   @relation("LeadAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  conversations Conversation[]
  activities    LeadActivity[]
  stageHistory  LeadStageHistory[]
  tasks         Task[]
  client        Client?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([contactId])
  @@index([stageId])
  @@index([assignedUserId])
}

model LeadActivity {
  id          String           @id @default(uuid())
  type        LeadActivityType
  description String
  metadata    Json?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?        @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([leadId, createdAt])
}

model LeadStageHistory {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStageId    String?
  toStageId      String
  toStage        PipelineStage @relation(fields: [toStageId], references: [id], onDelete: Restrict)
  changedById    String?
  changedAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([leadId, changedAt])
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  dueAt       DateTime
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  completedAt DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedUserId String?
  assignedUser   User?        @relation("TaskAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, dueAt])
  @@index([leadId])
  @@index([assignedUserId])
}

model MessageTemplate {
  id      String          @id @default(uuid())
  name    String
  channel TemplateChannel @default(WHATSAPP)
  content String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model AutomationRule {
  id           String            @id @default(uuid())
  name         String
  trigger      AutomationTrigger
  action       AutomationAction
  stageId      String?
  delayMinutes Int               @default(0)
  enabled      Boolean           @default(false)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model AuditLog {
  id         String  @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  metadata   Json?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId])
}

model NotificationDismissal {
  id  String @id @default(uuid())
  key String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  dismissedAt DateTime @default(now())

  @@unique([userId, key])
  @@index([organizationId])
}

model Property {
  id             String          @id @default(uuid())
  title          String
  reference      String?
  description    String?
  type           PropertyType
  purpose        PropertyPurpose
  status         PropertyStatus  @default(AVAILABLE)
  price          Decimal         @db.Decimal(14, 2)
  condominiumFee Decimal?        @db.Decimal(12, 2)
  propertyTax    Decimal?        @db.Decimal(12, 2)
  areaM2         Decimal?        @db.Decimal(10, 2)
  bedrooms       Int             @default(0)
  suites         Int             @default(0)
  bathrooms      Int             @default(0)
  parkingSpots   Int             @default(0)
  address        String?
  neighborhood   String?
  city           String
  state          String
  zipCode        String?
  amenities      String[]        @default([])
  featured       Boolean         @default(false)

  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  photos         PropertyPhoto[]
  ownerId        String?
  owner          Owner?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, type, purpose])
  @@index([organizationId, updatedAt])
  @@index([ownerId])
}

model Owner {
  id             String       @id @default(uuid())
  name           String
  phone          String?
  email          String?
  document       String?
  notes          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties     Property[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, name])
}

model Client {
  id             String       @id @default(uuid())
  name           String
  phone          String?
  email          String?
  document       String?
  notes          String?
  origin         String       @default("MANUAL")
  leadId         String?      @unique
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, name])
}

model PropertyPhoto {
  id        String @id @default(uuid())
  url       String
  objectKey String @unique
  position  Int
  mimeType  String
  sizeBytes Int

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([propertyId, position])
}
