generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  AGENT
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  CONTACT
  UNKNOWN
}

model Organization {
  id   String @id @default(uuid())
  name String

  users            User[]
  contacts         Contact[]
  conversations    Conversation[]
  messages         Message[]
  leads            Lead[]
  stages           PipelineStage[]
  whatsappAccounts WhatsappAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(AGENT)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedLeads Lead[] @relation("LeadAssignedUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model WhatsappAccount {
  id           String  @id @default(uuid())
  name         String
  phoneNumber  String
  externalId   String?
  instanceName String?
  isConnected  Boolean @default(false)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, phoneNumber])
  @@index([organizationId])
}

model Contact {
  id        String  @id @default(uuid())
  name      String?
  phone     String
  email     String?
  avatarUrl String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  conversations Conversation[]
  leads         Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, phone])
  @@index([organizationId])
}

model Conversation {
  id            String             @id @default(uuid())
  status        ConversationStatus @default(OPEN)
  unreadCount   Int                @default(0)
  lastMessageAt DateTime?
  externalId    String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  whatsappAccountId String
  whatsappAccount   WhatsappAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([whatsappAccountId, contactId])
  @@index([organizationId])
  @@index([contactId])
  @@index([lastMessageAt])
}

model Message {
  id         String           @id @default(uuid())
  externalId String?
  direction  MessageDirection
  type       MessageType      @default(TEXT)
  content    String?
  mediaUrl   String?
  sentAt     DateTime
  readAt     DateTime?
  metadata   Json?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, externalId])
  @@index([organizationId])
  @@index([conversationId, sentAt])
}

model PipelineStage {
  id       String  @id @default(uuid())
  name     String
  position Int
  color    String?
  isWon    Boolean @default(false)
  isLost   Boolean @default(false)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, position])
  @@index([organizationId])
}

model Lead {
  id             String    @id @default(uuid())
  title          String
  source         String?
  notes          String?
  estimatedValue Decimal?  @db.Decimal(12, 2)
  closedAt       DateTime?
  lostReason     String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  stageId String
  stage   PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  assignedUserId String?
  assignedUser   User?   @relation("LeadAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([contactId])
  @@index([stageId])
  @@index([assignedUserId])
}
